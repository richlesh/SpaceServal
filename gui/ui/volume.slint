// Per-volume disk-usage explorer window for SpaceServal.
//
// Shows a pie chart of the current directory's top-level contents. Each wedge
// is one immediate child; the legend lists each child's name and size on disk.
// Double-clicking a directory drills into it; the Up button goes back a level;
// the current path is shown at the bottom.
//
// Legend rows are selectable (plain click = single, Shift = contiguous range,
// Ctrl/Cmd = toggle). "What is this File" (File menu + right-click) opens an
// explanation dialog; "Delete Immediately…" permanently deletes the selection
// after a confirmation ("chicken") dialog.
//
// All geometry and explanations are computed by the Rust side and pushed in as
// models; the window reports user intent through callbacks.

import { Button, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

// One pie wedge / legend entry. Mirrors `scan::Wedge` on the Rust side.
export struct WedgeInfo {
    name: string,
    path: string,          // absolute path, used to drill into directories
    is-dir: bool,
    size-text: string,     // e.g. "1.20 GB"
    percent-text: string,  // e.g. "42%"
    commands: string,      // SVG path commands in a 200x200 viewbox
    color: brush,          // wedge fill color (built by the controller)
    start-deg: float,      // wedge start angle, clockwise from 12 o'clock
    sweep-deg: float,      // wedge angular span
}

// One entry shown in the "What is this File" dialog.
export struct ExplainEntry {
    name: string,
    format: string,
    purpose: string,
    safe-to-delete: string,
    online-url: string,
}

export component VolumeWindow inherits Window {
    title: "SpaceServal — " + root.volume-name;
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 420px;
    icon: root.window-icon;

    in property <image> window-icon;
    in property <bool> theme-dark: true;
    in property <length> base-font-size: 15px;
    default-font-size: root.base-font-size;
    // Windows/Linux show the declarative menu bar; macOS uses a native menu.
    in property <bool> use-slint-menubar: false;

    // Volume label shown in the title and header.
    in property <string> volume-name;
    // Absolute path of the directory currently displayed (bottom label).
    in property <string> current-path;
    // Whether we can go up a level (false at the volume root).
    in property <bool> can-go-up: false;
    // True while a background scan is running for the current directory.
    in property <bool> scanning: false;
    // Monotonic scan id; a finishing background scan whose id no longer matches
    // is discarded (the user navigated away before it completed).
    in-out property <int> scan-generation: 0;
    // Wedges for the current directory (empty ⇒ nothing to show).
    in property <[WedgeInfo]> wedges: [];
    // Per-row selection flags, parallel to `wedges`, maintained by the
    // controller in response to `select`.
    in property <[bool]> selected: [];
    // How many rows are currently selected (controller-maintained); gates the
    // File-menu / right-click actions.
    in property <int> selection-count: 0;

    // Navigation.
    callback drill-in(int /* index */);
    callback drill-at-angle(float /* degrees */);
    callback go-up();

    // Selection: `index` was clicked with Shift (range) and/or Ctrl/Cmd
    // (toggle) held. The controller updates `selected` + `selection-count`.
    callback select(int /* index */, bool /* shift */, bool /* toggle */);

    // Actions operating on the current selection.
    callback explain-selection();
    callback delete-selection();        // opens the confirm dialog
    callback confirm-delete();          // user confirmed — actually delete
    callback open-url(string);          // open a reference in the browser

    // Pie hover.
    callback hover-at-angle(float /* degrees */);
    callback hover-clear();
    in property <string> hovered-name: "";

    // --- Dialog state (controller-driven) ---
    in-out property <bool> show-explain: false;
    in property <[ExplainEntry]> explain-entries: [];
    in-out property <bool> show-confirm-delete: false;
    // Human-readable list of what will be deleted, shown in the chicken dialog.
    in property <string> confirm-names: "";

    property <bool> working-bright: false;

    // Local theme colors (independent of the main window's Theme global).
    property <bool> dark: root.theme-dark;
    property <brush> text: Palette.foreground;
    property <brush> muted: dark ? #9a9a9a : #666666;
    property <brush> card: dark ? #262626 : #f4f4f4;
    property <brush> card-bg: dark ? #2b2b2b : #f7f7f7;
    property <brush> hairline: dark ? #4a4a4a : #cccccc;
    property <brush> hover: dark ? #ffffff14 : #00000010;
    property <brush> sel: dark ? #3d5a80 : #cfe3ff;
    property <brush> scrim: dark ? #000000c0 : #00000060;
    property <brush> danger: dark ? #e0a0a0 : #b00020;

    // Live modifier-key state, tracked by the FocusScope below so a legend
    // click can tell plain / Shift / Ctrl-Cmd apart.
    property <bool> shift-down: false;
    property <bool> ctrl-down: false;

    background: Palette.background;

    init => {
        Palette.color-scheme = root.theme-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed theme-dark => {
        Palette.color-scheme = root.theme-dark ? ColorScheme.dark : ColorScheme.light;
    }

    working-timer := Timer {
        interval: 700ms;
        running: root.scanning;
        triggered => { root.working-bright = !root.working-bright; }
    }
    changed scanning => {
        if (!root.scanning) { root.working-bright = false; }
    }

    function report-hover() {
        root.hover-at-angle(Math.mod(
            Math.atan2((pie-touch.mouse-x - pie.width / 2) / 1px,
                       -(pie-touch.mouse-y - pie.height / 2) / 1px)
                / 1deg + 360, 360));
    }

    // Windows/Linux menu bar. macOS builds a native menu in Rust.
    if root.use-slint-menubar: MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "What is this File";
                enabled: root.selection-count > 0;
                activated => { root.explain-selection(); }
            }
            MenuItem {
                title: "Delete Immediately…";
                enabled: root.selection-count > 0;
                activated => { root.delete-selection(); }
            }
        }
    }

    // Track modifier keys for the whole window so legend clicks see them.
    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Shift) { root.shift-down = true; }
            if (event.text == Key.Control) { root.ctrl-down = true; }
            if (event.text == Key.Meta) { root.ctrl-down = true; }
            reject
        }
        key-released(event) => {
            if (event.text == Key.Shift) { root.shift-down = false; }
            if (event.text == Key.Control) { root.ctrl-down = false; }
            if (event.text == Key.Meta) { root.ctrl-down = false; }
            reject
        }

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            // Header: Up button + volume name.
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Button {
                    text: "↑ Up";
                    enabled: root.can-go-up;
                    clicked => { root.go-up(); }
                }
                Text {
                    text: root.volume-name;
                    font-size: 20px;
                    font-weight: 700;
                    color: root.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Body: pie on the left, scrollable legend on the right.
            HorizontalBox {
                padding: 0px;
                spacing: 16px;
                vertical-stretch: 1;

                // ---- Pie chart --------------------------------------------
                Rectangle {
                    width: 300px;
                    horizontal-stretch: 0;

                    pie := Rectangle {
                        width: min(parent.width, parent.height) - 16px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        for w[i] in root.wedges: Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 200;
                            viewbox-height: 200;
                            commands: w.commands;
                            fill: w.color;
                            stroke: root.card;
                            stroke-width: 0.5px;
                        }

                        pie-touch := TouchArea {
                            double-clicked => {
                                root.drill-at-angle(Math.mod(
                                    Math.atan2((self.mouse-x - pie.width / 2) / 1px,
                                               -(self.mouse-y - pie.height / 2) / 1px)
                                        / 1deg + 360, 360));
                            }
                            changed mouse-x => { root.report-hover(); }
                            changed mouse-y => { root.report-hover(); }
                            changed has-hover => {
                                if (self.has-hover) { root.report-hover(); }
                                else { root.hover-clear(); }
                            }
                        }

                        if root.hovered-name != "": Rectangle {
                            x: min(pie-touch.mouse-x + 12px, pie.width - self.width);
                            y: min(pie-touch.mouse-y + 12px, pie.height - self.height);
                            width: tip-text.preferred-width + 16px;
                            height: tip-text.preferred-height + 10px;
                            background: root.dark ? #000000d0 : #ffffffe0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.hairline;
                            tip-text := Text {
                                text: root.hovered-name;
                                color: root.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.wedges.length == 0 && !root.scanning: Text {
                        text: "Empty or unreadable";
                        color: root.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.scanning: Text {
                        text: "Working…";
                        color: root.text;
                        font-italic: true;
                        font-size: root.base-font-size + 1px;
                        horizontal-alignment: center;
                        y: parent.height - self.preferred-height - 4px;
                        opacity: root.working-bright ? 1.0 : 0.1;
                        animate opacity { duration: 650ms; easing: ease-in-out; }
                    }
                }

                // ---- Legend ------------------------------------------------
                Rectangle {
                    horizontal-stretch: 1;
                    background: root.card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.hairline;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            for w[i] in root.wedges: Rectangle {
                                height: root.base-font-size * 2 + 16px;
                                background: (i < root.selected.length && root.selected[i])
                                    ? root.sel
                                    : (legend-touch.has-hover ? root.hover : transparent);
                                border-radius: 4px;
                                ContextMenuArea {
                                    enabled: w.path != "";
                                    Menu {
                                        MenuItem {
                                            title: "What is this File";
                                            activated => {
                                                // Right-clicking an unselected
                                                // row selects it first.
                                                if (!(i < root.selected.length && root.selected[i])) {
                                                    root.select(i, false, false);
                                                }
                                                root.explain-selection();
                                            }
                                        }
                                        MenuItem {
                                            title: "Delete Immediately…";
                                            activated => {
                                                if (!(i < root.selected.length && root.selected[i])) {
                                                    root.select(i, false, false);
                                                }
                                                root.delete-selection();
                                            }
                                        }
                                    }
                                    legend-touch := TouchArea {
                                        mouse-cursor: w.is-dir ? pointer : default;
                                        clicked => {
                                            if (w.path != "") {
                                                root.select(i, root.shift-down, root.ctrl-down);
                                            }
                                        }
                                        double-clicked => { root.drill-in(i); }
                                    }
                                    legend-row := HorizontalBox {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: w.color;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        VerticalLayout {
                                            spacing: 1px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: w.name + (w.is-dir ? "/" : "");
                                                color: root.text;
                                                font-weight: w.is-dir ? 700 : 400;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: w.size-text + "  •  " + w.percent-text;
                                                color: root.muted;
                                                font-size: root.base-font-size - 2px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Current path at the bottom.
            Rectangle {
                height: path-text.preferred-height + 12px;
                background: root.card;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.hairline;
                path-text := Text {
                    text: root.current-path;
                    color: root.muted;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    x: 10px;
                    width: parent.width - 20px;
                    overflow: elide;
                }
            }
        }
    }

    // ---- "What is this File" dialog ----------------------------------------
    if root.show-explain: Rectangle {
        background: root.scrim;
        TouchArea { clicked => { root.show-explain = false; } }
        Rectangle {
            width: min(root.width - 80px, 520px);
            height: min(root.height - 80px, 560px);
            background: root.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.hairline;
            // Swallow clicks so they don't dismiss via the scrim.
            TouchArea {}
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "What is this File";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.text;
                    horizontal-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        for e in root.explain-entries: Rectangle {
                            background: root.card;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.hairline;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: e.name; font-weight: 700; color: root.text; wrap: word-wrap; }
                                Text { text: "Format: " + e.format; color: root.text; wrap: word-wrap; }
                                Text { text: "Used for: " + e.purpose; color: root.muted; wrap: word-wrap; }
                                Text { text: "Safe to delete? " + e.safe-to-delete; color: root.muted; wrap: word-wrap; }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    height: link-text.preferred-height;
                                    clicked => { root.open-url(e.online-url); }
                                    link-text := Text {
                                        text: "Look up online →";
                                        color: root.dark ? #5c9dff : #0a58ca;
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    Button { text: "Close"; clicked => { root.show-explain = false; } }
                }
            }
        }
    }

    // ---- Delete confirmation ("chicken") dialog ----------------------------
    if root.show-confirm-delete: Rectangle {
        background: root.scrim;
        TouchArea { clicked => { root.show-confirm-delete = false; } }
        Rectangle {
            width: min(root.width - 80px, 460px);
            height: confirm-col.preferred-height + 32px;
            background: root.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.hairline;
            TouchArea {}
            confirm-col := VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Delete immediately?";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.danger;
                    horizontal-alignment: center;
                }
                Text {
                    text: "This permanently deletes the following "
                        + root.selection-count + " item(s). They are NOT moved to the "
                        + "Trash/Recycle Bin and this CANNOT be undone:";
                    color: root.text;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                ScrollView {
                    height: 140px;
                    VerticalLayout {
                        Text {
                            text: root.confirm-names;
                            color: root.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.show-confirm-delete = false; }
                    }
                    Button {
                        text: "Delete Permanently";
                        clicked => {
                            root.show-confirm-delete = false;
                            root.confirm-delete();
                        }
                    }
                }
            }
        }
    }
}
