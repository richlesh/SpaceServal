// Per-volume disk-usage explorer window for SpaceServal.
//
// Shows a pie chart of the current directory's top-level contents. Each wedge
// is one immediate child; the legend lists each child's name and size on disk.
// Double-clicking a directory drills into it; the Up button goes back a level;
// the current path is shown at the bottom.
//
// Legend rows are selectable (plain click = single, Shift = contiguous range,
// Ctrl/Cmd = toggle). "What is this File" (File menu + right-click) opens an
// explanation dialog; "Delete Immediately…" permanently deletes the selection
// after a confirmation ("chicken") dialog.
//
// All geometry and explanations are computed by the Rust side and pushed in as
// models; the window reports user intent through callbacks.

import { Button, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

// One pie wedge / legend entry. Mirrors `scan::Wedge` on the Rust side.
export struct WedgeInfo {
    name: string,
    path: string,          // absolute path, used to drill into directories
    is-dir: bool,
    size-text: string,     // e.g. "1.20 GB"
    percent-text: string,  // e.g. "42%"
    commands: string,      // SVG path commands in a 200x200 viewbox
    color: brush,          // wedge fill color (built by the controller)
    start-deg: float,      // wedge start angle, clockwise from 12 o'clock
    sweep-deg: float,      // wedge angular span
}

// One entry shown in the "What is this File" dialog.
export struct ExplainEntry {
    name: string,
    format: string,
    purpose: string,
    safe-to-delete: string,
    online-url: string,
}

// A square, icon-only toolbar button used for the volume window's actions.
// Draws one of a few built-in line icons, flashes the OS highlight color while
// pressed, dims when disabled, and shows a hover tooltip below itself.
component IconButton inherits Rectangle {
    // Which icon to draw: "open" (open folder), "question", "trash", or
    // "refresh" (circular reload arrow).
    in property <string> icon-kind;
    in property <string> tooltip;
    in property <bool> enabled: true;
    // Theme-driven colors supplied by the owner.
    in property <brush> icon-color;
    in property <brush> muted-color;
    in property <brush> hover-color;
    in property <brush> highlight-color;
    in property <brush> highlight-text;
    in property <brush> tooltip-bg;
    in property <brush> tooltip-border;
    in property <length> base-size: 15px;

    callback clicked();
    // Hover reporting: the owner renders the tooltip in a top-level overlay so
    // it draws above sibling content (e.g. the file list). `x`/`y` are the
    // desired tooltip top-left in window coordinates.
    callback show-tip(string /* text */, length /* win x */, length /* win y */);
    callback hide-tip();

    // Square, sized relative to the font.
    width: root.base-size * 2.2;
    height: self.width;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.enabled ? root.hover-color : transparent;
    // Pressed = OS highlight; hovered = subtle wash; otherwise flat.
    background: !root.enabled
        ? transparent
        : (touch.pressed ? root.highlight-color
            : (touch.has-hover ? root.hover-color : transparent));
    opacity: root.enabled ? 1.0 : 0.4;

    // Icon glyph. Stroked line-art in a 24x24 viewbox; the stroke color
    // flips to the highlight-text color while pressed for contrast.
    icon := Path {
        // Icon occupies 75% of the button (50% larger than the previous 50%),
        // kept centered.
        x: parent.width * 0.125;
        y: parent.height * 0.125;
        width: parent.width * 0.75;
        height: parent.height * 0.75;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: touch.pressed ? root.highlight-text : root.icon-color;
        stroke-width: 2px;
        // Round caps/joins so the question-mark stem and dot read cleanly.
        stroke-line-cap: round;
        commands:
            root.icon-kind == "open"
                // Open folder.
                ? "M 3 7 L 3 19 L 21 19 L 21 10 L 10 10 L 8 7 Z"
            : root.icon-kind == "trash"
                // Trash can: lid, handle, body, two stripes.
                ? "M 4 6 L 20 6 M 9 6 L 9 4 L 15 4 L 15 6 "
                    + "M 6 6 L 7 20 L 17 20 L 18 6 "
                    + "M 10 10 L 10 17 M 14 10 L 14 17"
            : root.icon-kind == "refresh"
                // Reload: a near-full circular arrow (gap at the top-right)
                // with an arrowhead at the open end, like a browser refresh.
                // Geometry: center (12,12), r=8, a 300deg clockwise arc leaving
                // a gap at the top; the arrowhead sits tangent at the open end.
                ? "M 19.518 9.264 A 8 8 0 1 1 13.389 4.122 "  // 300deg arc, clockwise
                    + "M 9.068 5.594 L 13.389 4.122 L 9.832 1.260"  // tangent arrowhead
                // Question mark: hook, a prominent vertical stem at the
                // bottom, and a round dot clearly separated underneath.
                : "M 8.5 9 C 8.5 6 11 5 12 5 C 14 5 15.5 6.3 15.5 8.3 "
                    + "C 15.5 10.5 12 11 12 13 "   // hook into the stem top
                    + "M 12 13 L 12 16 "            // prominent vertical stem
                    + "M 12 19.5 L 12 19.7";        // round dot underneath
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.enabled && root.tooltip != "") {
                // Report the anchor just below the button, horizontally
                // centered, in window coordinates.
                root.show-tip(root.tooltip,
                    root.absolute-position.x,
                    root.absolute-position.y + root.height + 4px);
            } else {
                root.hide-tip();
            }
        }
    }
}

export component VolumeWindow inherits Window {
    title: "SpaceServal — " + root.volume-name;
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 420px;
    icon: root.window-icon;

    in property <image> window-icon;
    in property <bool> theme-dark: true;
    in property <length> base-font-size: 15px;
    default-font-size: root.base-font-size;
    // Windows/Linux show the declarative menu bar; macOS uses a native menu.
    in property <bool> use-slint-menubar: false;

    // Volume label shown in the title and header.
    in property <string> volume-name;
    // Absolute path of the directory currently displayed (bottom label).
    in property <string> current-path;
    // Whether we can go up a level (false at the volume root).
    in property <bool> can-go-up: false;
    // True while a background scan is running for the current directory.
    in property <bool> scanning: false;
    // Monotonic scan id; a finishing background scan whose id no longer matches
    // is discarded (the user navigated away before it completed).
    in-out property <int> scan-generation: 0;
    // Wedges for the current directory (empty ⇒ nothing to show).
    in property <[WedgeInfo]> wedges: [];
    // Per-row selection flags, parallel to `wedges`, maintained by the
    // controller in response to `select`.
    in property <[bool]> selected: [];
    // How many rows are currently selected (controller-maintained); gates the
    // File-menu / right-click actions.
    in property <int> selection-count: 0;

    // Request to scroll a legend row into view (e.g. after a pie-wedge click
    // selected an off-screen row). The controller sets `scroll-to-index` to
    // the row and bumps `scroll-generation` to trigger the scroll even when
    // the same index is requested twice in a row. -1 means "no request".
    in property <int> scroll-to-index: -1;
    in property <int> scroll-generation: 0;

    // Navigation.
    callback drill-in(int /* index */);
    callback drill-at-angle(float /* degrees */);
    callback go-up();

    // Selection: `index` was clicked with Shift (range) and/or Ctrl/Cmd
    // (toggle) held. The controller updates `selected` + `selection-count`.
    callback select(int /* index */, bool /* shift */, bool /* toggle */);

    // Selection from the pie chart: the wedge at `degrees` (clockwise from 12
    // o'clock) was clicked. The controller maps the angle to a wedge index and
    // applies the same selection logic as `select`.
    callback select-at-angle(float /* degrees */, bool /* shift */, bool /* toggle */);
    // Like `ensure-selected`, but for a pie wedge: selects the wedge at the
    // angle if it isn't already selected (used before a right-click menu).
    callback ensure-selected-at-angle(float /* degrees */);

    // Actions operating on the current selection.
    callback explain-selection();
    callback delete-selection();        // opens the confirm dialog
    callback confirm-delete();          // user confirmed — actually delete
    callback open-url(string);          // open a reference in the browser
    callback open-selection();          // open selected items with the OS
    // Discard the current directory's cached scan and re-read it from disk.
    // Unlike the selection actions, this needs no selection.
    callback refresh();

    // macOS only: the legend was right-clicked at the given window-relative
    // point. The controller shows a native muda context menu there (Slint's
    // own `ContextMenuArea` can't be used on macOS — see `menu_macos`). The
    // right-clicked row is selected first via `ensure-selected`.
    callback request-context-menu(length /* win x */, length /* win y */);

    // Pie hover.
    callback hover-at-angle(float /* degrees */);
    callback hover-clear();
    in property <string> hovered-name: "";

    // --- Dialog state (controller-driven) ---
    in-out property <bool> show-explain: false;
    in property <[ExplainEntry]> explain-entries: [];
    in-out property <bool> show-confirm-delete: false;
    // Human-readable list of what will be deleted, shown in the chicken dialog.
    in property <string> confirm-names: "";

    // Delete-results dialog, shown after a delete completes. Lists what was
    // removed and what could not be removed (e.g. permission errors).
    in-out property <bool> show-delete-results: false;
    // Multi-line list of successfully deleted entries ("" ⇒ none).
    in property <string> deleted-names: "";
    // Multi-line list of entries that could not be deleted, each with the
    // reason ("" ⇒ none).
    in property <string> failed-names: "";

    property <bool> working-bright: false;

    // Local theme colors (independent of the main window's Theme global).
    property <bool> dark: root.theme-dark;
    property <brush> text: Palette.foreground;
    property <brush> muted: dark ? #9a9a9a : #666666;
    property <brush> card: dark ? #262626 : #f4f4f4;
    property <brush> card-bg: dark ? #2b2b2b : #f7f7f7;
    property <brush> hairline: dark ? #4a4a4a : #cccccc;
    property <brush> hover: dark ? #ffffff14 : #00000010;
    property <brush> sel: dark ? #3d5a80 : #cfe3ff;
    property <brush> scrim: dark ? #000000c0 : #00000060;
    property <brush> danger: dark ? #e0a0a0 : #b00020;

    // Toolbar-button tooltip overlay state. The tooltip is rendered as the
    // window's last child so it draws on top of the file list; the icon
    // buttons feed it via `show-tip` / `hide-tip`.
    property <string> tip-text: "";
    property <length> tip-x;
    property <length> tip-y;

    // The OS highlight/accent color, pushed in by the controller so the icon
    // buttons flash in the user's chosen color when pressed. Falls back to the
    // local selection color when the OS color isn't available.
    in property <brush> highlight-color: root.sel;

    // Live modifier-key state, tracked by the FocusScope below so a legend
    // click can tell plain / Shift / Ctrl-Cmd apart.
    property <bool> shift-down: false;
    property <bool> ctrl-down: false;

    background: Palette.background;

    init => {
        Palette.color-scheme = root.theme-dark ? ColorScheme.dark : ColorScheme.light;
        key-scope.focus();
    }
    changed theme-dark => {
        Palette.color-scheme = root.theme-dark ? ColorScheme.dark : ColorScheme.light;
    }

    working-timer := Timer {
        interval: 700ms;
        running: root.scanning;
        triggered => { root.working-bright = !root.working-bright; }
    }
    changed scanning => {
        if (!root.scanning) { root.working-bright = false; }
    }

    // Scroll a requested legend row into view (e.g. after a pie-wedge click
    // selected an off-screen row). `legend-scroll` is the legend ScrollView.
    changed scroll-generation => {
        if (root.scroll-to-index >= 0) {
            legend-scroll.content-y = root.scroll-offset-for(
                root.scroll-to-index,
                legend-scroll.visible-height,
                legend-scroll.content-y);
        }
    }

    function report-hover() {
        root.hover-at-angle(Math.mod(
            Math.atan2((pie-touch.mouse-x - pie.width / 2) / 1px,
                       -(pie-touch.mouse-y - pie.height / 2) / 1px)
                / 1deg + 360, 360));
    }

    // The pie angle (degrees, clockwise from 12 o'clock) under the pie
    // pointer. Shared by hover, click-to-select, drill, and the right-click
    // menu so they all agree on which wedge is under the cursor.
    function pie-angle() -> float {
        return Math.mod(
            Math.atan2((pie-touch.mouse-x - pie.width / 2) / 1px,
                       -(pie-touch.mouse-y - pie.height / 2) / 1px)
                / 1deg + 360, 360);
    }

    // Legend row height (kept in sync with the row Rectangle below) and the
    // VerticalLayout's top padding, used to compute scroll offsets.
    property <length> row-h: root.base-font-size * 2 + 16px;
    property <length> legend-pad: 8px;
    property <length> legend-gap: 2px;

    // New `content-y` for the legend ScrollView so row `index` is visible
    // within a viewport of `visible-h`, given the current `cur-y`. `content-y`
    // is 0 at the top and negative when scrolled down.
    function scroll-offset-for(index: int, visible-h: length, cur-y: length) -> length {
        if (index < 0) {
            return cur-y;
        }
        // Row top in content coordinates (mirrors the VerticalLayout).
        //   top    = legend-pad + index * (row-h + legend-gap)
        //   bottom = top + row-h
        // Visible content window is [-cur-y, -cur-y + visible-h].
        // Above the view: bring the row's top to the viewport top.
        if (root.legend-pad + index * (root.row-h + root.legend-gap) < -cur-y) {
            return -(root.legend-pad + index * (root.row-h + root.legend-gap));
        }
        // Below the view: bring the row's bottom to the viewport bottom.
        if (root.legend-pad + index * (root.row-h + root.legend-gap) + root.row-h
                > -cur-y + visible-h) {
            return min(0px, visible-h
                - (root.legend-pad + index * (root.row-h + root.legend-gap) + root.row-h));
        }
        return cur-y;
    }

    // If row `i` isn't already selected, select just it (so a menu action on a
    // right-clicked, previously-unselected row operates on that row).
    function ensure-selected(i: int) {
        if (!(i < root.selected.length && root.selected[i])) {
            root.select(i, false, false);
        }
    }

    // Windows/Linux menu bar. macOS builds a native menu in Rust.
    if root.use-slint-menubar: MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open";
                enabled: root.selection-count > 0;
                activated => { root.open-selection(); }
            }
            MenuItem {
                title: "What is this File";
                enabled: root.selection-count > 0;
                activated => { root.explain-selection(); }
            }
            MenuItem {
                title: "Delete Immediately…";
                enabled: root.selection-count > 0;
                activated => { root.delete-selection(); }
            }
        }
    }

    // Track modifier keys for the whole window so legend clicks see them.
    key-scope := FocusScope {
        // While a dialog is open, don't let the main scope hold focus — it
        // would otherwise keep keyboard focus and the dialog's first click
        // would be spent transferring focus to the dialog.
        enabled: !root.show-explain && !root.show-confirm-delete && !root.show-delete-results;
        key-pressed(event) => {
            if (event.text == Key.Shift) { root.shift-down = true; }
            if (event.text == Key.Control) { root.ctrl-down = true; }
            if (event.text == Key.Meta) { root.ctrl-down = true; }
            reject
        }
        key-released(event) => {
            if (event.text == Key.Shift) { root.shift-down = false; }
            if (event.text == Key.Control) { root.ctrl-down = false; }
            if (event.text == Key.Meta) { root.ctrl-down = false; }
            reject
        }

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            // Header: Up button + volume name.
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Button {
                    text: "↑ Up";
                    enabled: root.can-go-up;
                    clicked => { root.go-up(); }
                }
                Text {
                    text: root.volume-name;
                    font-size: 20px;
                    font-weight: 700;
                    color: root.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Action buttons mirror the File / right-click menu. Square
                // icon buttons that act on the current selection; they flash
                // the OS highlight color when pressed and show a tooltip on
                // hover. Always available (the native menu bar isn't rendered
                // on macOS).
                IconButton {
                    icon-kind: "open";
                    tooltip: "Open";
                    enabled: root.selection-count > 0;
                    icon-color: root.text;
                    muted-color: root.muted;
                    hover-color: root.hover;
                    highlight-color: root.highlight-color;
                    highlight-text: #ffffff;
                    tooltip-bg: root.dark ? #000000d0 : #ffffffe0;
                    tooltip-border: root.hairline;
                    base-size: root.base-font-size;
                    clicked => { root.open-selection(); }
                    show-tip(t, tx, ty) => { root.tip-text = t; root.tip-x = tx; root.tip-y = ty; }
                    hide-tip => { root.tip-text = ""; }
                }
                IconButton {
                    icon-kind: "question";
                    tooltip: "What is this File";
                    enabled: root.selection-count > 0;
                    icon-color: root.text;
                    muted-color: root.muted;
                    hover-color: root.hover;
                    highlight-color: root.highlight-color;
                    highlight-text: #ffffff;
                    tooltip-bg: root.dark ? #000000d0 : #ffffffe0;
                    tooltip-border: root.hairline;
                    base-size: root.base-font-size;
                    clicked => { root.explain-selection(); }
                    show-tip(t, tx, ty) => { root.tip-text = t; root.tip-x = tx; root.tip-y = ty; }
                    hide-tip => { root.tip-text = ""; }
                }
                IconButton {
                    icon-kind: "trash";
                    tooltip: "Delete Immediately";
                    enabled: root.selection-count > 0;
                    icon-color: root.danger;
                    muted-color: root.muted;
                    hover-color: root.hover;
                    highlight-color: root.highlight-color;
                    highlight-text: #ffffff;
                    tooltip-bg: root.dark ? #000000d0 : #ffffffe0;
                    tooltip-border: root.hairline;
                    base-size: root.base-font-size;
                    clicked => { root.delete-selection(); }
                    show-tip(t, tx, ty) => { root.tip-text = t; root.tip-x = tx; root.tip-y = ty; }
                    hide-tip => { root.tip-text = ""; }
                }
                // Refresh: re-read the current directory from disk, bypassing
                // the cache. Always enabled (it doesn't operate on a selection).
                IconButton {
                    icon-kind: "refresh";
                    tooltip: "Refresh";
                    enabled: !root.scanning;
                    icon-color: root.text;
                    muted-color: root.muted;
                    hover-color: root.hover;
                    highlight-color: root.highlight-color;
                    highlight-text: #ffffff;
                    tooltip-bg: root.dark ? #000000d0 : #ffffffe0;
                    tooltip-border: root.hairline;
                    base-size: root.base-font-size;
                    clicked => { root.refresh(); }
                    show-tip(t, tx, ty) => { root.tip-text = t; root.tip-x = tx; root.tip-y = ty; }
                    hide-tip => { root.tip-text = ""; }
                }
            }

            // Body: pie on the left, scrollable legend on the right.
            HorizontalBox {
                padding: 0px;
                spacing: 16px;
                vertical-stretch: 1;

                // ---- Pie chart --------------------------------------------
                Rectangle {
                    width: 300px;
                    horizontal-stretch: 0;

                    pie := Rectangle {
                        width: min(parent.width, parent.height) - 16px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        // Right-click menu for the wedge under the pointer.
                        // Mirrors the legend's menu; the TouchArea below sits on
                        // top and drives it programmatically (Win/Linux native
                        // Slint; macOS routes to a muda menu in Rust) so the
                        // left-click / double-click gestures still reach us.
                        pie-ctx := ContextMenuArea {
                            width: 100%;
                            height: 100%;
                            Menu {
                                MenuItem {
                                    title: "Open";
                                    activated => { root.open-selection(); }
                                }
                                MenuItem {
                                    title: "What is this File";
                                    activated => { root.explain-selection(); }
                                }
                                MenuItem {
                                    title: "Delete Immediately…";
                                    activated => { root.delete-selection(); }
                                }
                            }
                            Rectangle {
                                for w[i] in root.wedges: Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 200;
                                    viewbox-height: 200;
                                    commands: w.commands;
                                    fill: w.color;
                                    stroke: root.card;
                                    stroke-width: 0.5px;
                                }
                            }
                        }

                        // On top of the wedges + ctx so clicks reliably reach
                        // it. Left-click selects the wedge's row; right-click
                        // selects it then opens the menu; double-click drills.
                        pie-touch := TouchArea {
                            double-clicked => { root.drill-at-angle(root.pie-angle()); }
                            clicked => {
                                root.select-at-angle(root.pie-angle(), root.shift-down, root.ctrl-down);
                                key-scope.focus();
                            }
                            pointer-event(ev) => {
                                if (ev.button == PointerEventButton.right
                                    && ev.kind == PointerEventKind.down) {
                                    root.ensure-selected-at-angle(root.pie-angle());
                                    if (root.use-slint-menubar) {
                                        pie-ctx.show({ x: self.mouse-x, y: self.mouse-y });
                                    } else {
                                        root.request-context-menu(
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                            changed mouse-x => { root.report-hover(); }
                            changed mouse-y => { root.report-hover(); }
                            changed has-hover => {
                                if (self.has-hover) { root.report-hover(); }
                                else { root.hover-clear(); }
                            }
                        }

                        if root.hovered-name != "": Rectangle {
                            x: min(pie-touch.mouse-x + 12px, pie.width - self.width);
                            y: min(pie-touch.mouse-y + 12px, pie.height - self.height);
                            width: tip-text.preferred-width + 16px;
                            height: tip-text.preferred-height + 10px;
                            background: root.dark ? #000000d0 : #ffffffe0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.hairline;
                            tip-text := Text {
                                text: root.hovered-name;
                                color: root.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.wedges.length == 0 && !root.scanning: Text {
                        text: "Empty or unreadable";
                        color: root.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.scanning: Text {
                        text: "Working…";
                        color: root.text;
                        font-italic: true;
                        font-size: root.base-font-size + 1px;
                        horizontal-alignment: center;
                        y: parent.height - self.preferred-height - 4px;
                        opacity: root.working-bright ? 1.0 : 0.1;
                        animate opacity { duration: 650ms; easing: ease-in-out; }
                    }
                }

                // ---- Legend ------------------------------------------------
                Rectangle {
                    horizontal-stretch: 1;
                    background: root.card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.hairline;

                    legend-scroll := ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            for w[i] in root.wedges: Rectangle {
                                height: root.base-font-size * 2 + 16px;
                                background: (i < root.selected.length && root.selected[i])
                                    ? root.sel
                                    : (legend-touch.has-hover ? root.hover : transparent);
                                border-radius: 4px;
                                // Right-click menu, shown programmatically from
                                // the TouchArea below so left-clicks (select)
                                // and double-clicks (drill) still reach us.
                                ctx := ContextMenuArea {
                                    enabled: w.path != "";
                                    Menu {
                                        MenuItem {
                                            title: "Open";
                                            activated => { root.ensure-selected(i); root.open-selection(); }
                                        }
                                        MenuItem {
                                            title: "What is this File";
                                            activated => { root.ensure-selected(i); root.explain-selection(); }
                                        }
                                        MenuItem {
                                            title: "Delete Immediately…";
                                            activated => { root.ensure-selected(i); root.delete-selection(); }
                                        }
                                    }
                                    legend-row := HorizontalBox {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: w.color;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        VerticalLayout {
                                            spacing: 1px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: w.name + (w.is-dir ? "/" : "");
                                                color: root.text;
                                                font-weight: w.is-dir ? 700 : 400;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: w.size-text + "  •  " + w.percent-text;
                                                color: root.muted;
                                                font-size: root.base-font-size - 2px;
                                            }
                                        }
                                    }
                                }
                                // On top so clicks reliably reach it. Left-click
                                // selects; right-click opens the context menu at
                                // the pointer; double-click drills in.
                                legend-touch := TouchArea {
                                    mouse-cursor: w.is-dir ? pointer : default;
                                    pointer-event(ev) => {
                                        if (ev.button == PointerEventButton.right
                                            && ev.kind == PointerEventKind.down
                                            && w.path != "") {
                                            root.ensure-selected(i);
                                            // Windows/Linux use Slint's native
                                            // ContextMenuArea. macOS routes to a
                                            // muda menu built in Rust, because
                                            // Slint's context-menu muda events
                                            // are swallowed by our app menu's
                                            // global muda handler there.
                                            if (root.use-slint-menubar) {
                                                ctx.show({ x: self.mouse-x, y: self.mouse-y });
                                            } else {
                                                root.request-context-menu(
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    clicked => {
                                        if (w.path != "") {
                                            root.select(i, root.shift-down, root.ctrl-down);
                                            key-scope.focus();
                                        }
                                    }
                                    double-clicked => { root.drill-in(i); }
                                }
                            }
                        }
                    }
                }
            }

            // Current path at the bottom.
            Rectangle {
                height: path-text.preferred-height + 12px;
                background: root.card;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.hairline;
                path-text := Text {
                    text: root.current-path;
                    color: root.muted;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    x: 10px;
                    width: parent.width - 20px;
                    overflow: elide;
                }
            }
        }
    }

    // ---- "What is this File" dialog ----------------------------------------
    if root.show-explain: Rectangle {
        background: root.scrim;
        TouchArea { clicked => { root.show-explain = false; } }
        // Grab keyboard focus the moment the dialog appears, so the first
        // click lands on a button instead of being spent transferring focus
        // into the dialog. (The main `key-scope` is disabled while a dialog is
        // open, which releases focus but doesn't hand it to anyone.)
        explain-focus := FocusScope {
            // Grabbing focus in `init` races with layout and with the main
            // key-scope being disabled, so focus often doesn't stick. A
            // one-shot timer re-grabs it on the next tick, once the dialog is
            // laid out and the main scope has released focus.
            init => { explain-focus.focus(); }
            Timer {
                interval: 1ms;
                running: root.show-explain;
                triggered => { explain-focus.focus(); self.running = false; }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.show-explain = false; }
                accept
            }
            Rectangle {
            width: min(root.width - 80px, 520px);
            height: min(root.height - 80px, 560px);
            background: root.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.hairline;
            // Swallow clicks so they don't dismiss via the scrim.
            TouchArea {}
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "What is this File";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.text;
                    horizontal-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        for e in root.explain-entries: Rectangle {
                            background: root.card;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.hairline;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: e.name; font-weight: 700; color: root.text; wrap: word-wrap; }
                                Text { text: "Format: " + e.format; color: root.text; wrap: word-wrap; }
                                Text { text: "Used for: " + e.purpose; color: root.muted; wrap: word-wrap; }
                                Text { text: "Safe to delete? " + e.safe-to-delete; color: root.muted; wrap: word-wrap; }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    height: link-text.preferred-height;
                                    clicked => { root.open-url(e.online-url); }
                                    link-text := Text {
                                        text: "Look up online →";
                                        color: root.dark ? #5c9dff : #0a58ca;
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    Button { text: "Close"; clicked => { root.show-explain = false; } }
                }
            }
            }
        }
    }

    // ---- Delete confirmation ("chicken") dialog ----------------------------
    if root.show-confirm-delete: Rectangle {
        background: root.scrim;
        TouchArea { clicked => { root.show-confirm-delete = false; } }
        // Grab keyboard focus the moment the dialog appears, so the first
        // click lands on a button instead of being spent transferring focus
        // into the dialog.
        confirm-focus := FocusScope {
            // See the explain dialog: a one-shot timer re-grabs focus once the
            // dialog is laid out and the main scope has released focus, so the
            // first key/click lands here instead of being spent on focus.
            init => { confirm-focus.focus(); }
            Timer {
                interval: 1ms;
                running: root.show-confirm-delete;
                triggered => { confirm-focus.focus(); self.running = false; }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.show-confirm-delete = false; }
                accept
            }
            Rectangle {
            width: min(root.width - 80px, 460px);
            height: confirm-col.preferred-height + 32px;
            background: root.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.hairline;
            TouchArea {}
            confirm-col := VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Delete immediately?";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.danger;
                    horizontal-alignment: center;
                }
                Text {
                    text: "This permanently deletes the following "
                        + root.selection-count + " item(s). They are NOT moved to the "
                        + "Trash/Recycle Bin and this CANNOT be undone:";
                    color: root.text;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                ScrollView {
                    height: 140px;
                    VerticalLayout {
                        Text {
                            text: root.confirm-names;
                            color: root.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.show-confirm-delete = false; }
                    }
                    Button {
                        text: "Delete Permanently";
                        clicked => {
                            // The controller performs the delete AND dismisses
                            // the dialog (`set_show_confirm_delete(false)`).
                            // Doing the dismiss here instead tore this subtree
                            // down mid-click and dropped the first activation
                            // (needing a second click).
                            root.confirm-delete();
                        }
                    }
                }
            }
            }
        }
    }

    // ---- Delete results dialog --------------------------------------------
    // Shown after a delete completes: lists what was removed and what could
    // not be (e.g. permission errors).
    if root.show-delete-results: Rectangle {
        background: root.scrim;
        TouchArea { clicked => { root.show-delete-results = false; } }
        results-focus := FocusScope {
            init => { results-focus.focus(); }
            Timer {
                interval: 1ms;
                running: root.show-delete-results;
                triggered => { results-focus.focus(); self.running = false; }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.show-delete-results = false; }
                accept
            }
            Rectangle {
            width: min(root.width - 80px, 520px);
            height: min(root.height - 80px, 560px);
            background: root.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.hairline;
            // Swallow clicks so they don't dismiss via the scrim.
            TouchArea {}
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Delete results";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.text;
                    horizontal-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        // Successfully deleted.
                        if root.deleted-names != "": Rectangle {
                            background: root.card;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.hairline;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "Deleted";
                                    font-weight: 700;
                                    color: root.text;
                                }
                                Text {
                                    text: root.deleted-names;
                                    color: root.muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // Could not be deleted (permission or other errors).
                        if root.failed-names != "": Rectangle {
                            background: root.card;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.hairline;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: "Could not delete";
                                    font-weight: 700;
                                    color: root.danger;
                                }
                                Text {
                                    text: root.failed-names;
                                    color: root.muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // Nothing at all (shouldn't normally happen, but keep
                        // the dialog meaningful).
                        if root.deleted-names == "" && root.failed-names == "": Text {
                            text: "Nothing was deleted.";
                            color: root.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalBox {
                    alignment: end;
                    Button { text: "Close"; clicked => { root.show-delete-results = false; } }
                }
            }
            }
        }
    }

    // Toolbar-button tooltip. Rendered as the window's last child so it draws
    // on top of the file list and other content.
    if root.tip-text != "": Rectangle {
        x: min(max(0px, root.tip-x), root.width - self.width);
        y: min(root.tip-y, root.height - self.height);
        width: overlay-tip.preferred-width + 12px;
        height: overlay-tip.preferred-height + 8px;
        background: root.dark ? #000000d0 : #ffffffe0;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.hairline;
        overlay-tip := Text {
            text: root.tip-text;
            color: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
